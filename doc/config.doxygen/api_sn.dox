@anchor sn_get_product_form_chain_params
### sn_get_product_form_chain_params
  <b>Description:</b> Extracts product-form parameters aggregated by chain

  <b>Syntax:</b>
  @code
  [lambda, D, N, Z, mu, S, V] = sn_get_product_form_chain_params(sn)
  @endcode

  <b>Parameters:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>sn</td><td>Stochastic network structure</td></tr>
  </table>

  <b>Returns:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>lambda</td><td>Arrival rates or eigenvalues</td></tr>
  <tr><td>D</td><td>Service demand matrix</td></tr>
  <tr><td>N</td><td>Population vector or number of classes</td></tr>
  <tr><td>Z</td><td>Think times or partition function</td></tr>
  <tr><td>mu</td><td>Service rates or mean values</td></tr>
  <tr><td>S</td><td>Service time or state probabilities</td></tr>
  <tr><td>V</td><td>Visit ratios</td></tr>
  </table>

@anchor sn_get_product_form_params
### sn_get_product_form_params
  <b>Description:</b> Extracts standard product-form parameters from the network structure

  <b>Syntax:</b>
  @code
  [lambda, D, N, Z, mu, S, V] = sn_get_product_form_params(sn)
  @endcode

  <b>Parameters:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>sn</td><td>Stochastic network structure</td></tr>
  </table>

  <b>Returns:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>lambda</td><td>Arrival rates or eigenvalues</td></tr>
  <tr><td>D</td><td>Service demand matrix</td></tr>
  <tr><td>N</td><td>Population vector or number of classes</td></tr>
  <tr><td>Z</td><td>Think times or partition function</td></tr>
  <tr><td>mu</td><td>Service rates or mean values</td></tr>
  <tr><td>S</td><td>Service time or state probabilities</td></tr>
  <tr><td>V</td><td>Visit ratios</td></tr>
  </table>

