  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>L</td><td>Service demand matrix (MxR).</td></tr>
  <tr><td>N</td><td>Population vector (1xR).</td></tr>
  <tr><td>Z</td><td>Think time vector (1xR).</td></tr>
  <tr><td>I</td><td>Number of samples (default: 1e5).</td></tr>
  </table>

  <b>Returns:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>Gn</td><td>Estimated normalizing constant.</td></tr>
