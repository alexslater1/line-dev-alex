  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>XN</td><td>System throughput.</td></tr>
  <tr><td>QN</td><td>Mean queue lengths.</td></tr>
  <tr><td>UN</td><td>Utilization (adjusted for multiservers).</td></tr>
  <tr><td>CN</td><td>Cycle times.</td></tr>
  <tr><td>lGN</td><td>Logarithm of normalizing constant.</td></tr>
  </table>

