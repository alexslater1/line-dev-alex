  @endcode

  <b>Parameters:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>D</td><td>Service demand matrix.</td></tr>
  <tr><td>N</td><td>Population vector.</td></tr>
  <tr><td>Z</td><td>Think time vector.</td></tr>
  <tr><td>I</td><td>Number of samples (default: 1e5).</td></tr>
  <tr><td>variant</td><td>MCI variant ('mci', 'imci', 'rm', default: 'imci').</td></tr>
  </table>

  <b>Returns:</b>
  <table>
  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>G</td><td>Normalizing constant estimate.</td></tr>
