  <tr><th>Name</th><th>Description</th></tr>
  <tr><td>L</td><td>Service demand matrix.</td></tr>
  <tr><td>N</td><td>Population vector.</td></tr>
  <tr><td>ga</td><td>Gamma scaling function (default: ones).</td></tr>
  <tr><td>be</td><td>Beta scaling function (default: ones).</td></tr>
  <tr><td>Q0</td><td>Initial queue length estimate (optional).</td></tr>
  </table>

  <b>Returns:</b>
  <table>
