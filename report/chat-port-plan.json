{"parentUuid":"30ae6bb6-fc19-416f-9431-bddb3f6bacda","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/alex/Documents/FYP/line-dev/jar/src/main/kotlin/jline/solvers/ln_simple/SolverLNSimple.java","snippet":"1\tpackage jline.solvers.ln_simple;\n2\t\n3\timport jline.lang.ClosedClass;\n4\timport jline.lang.JobClass;\n5\timport jline.lang.Network;\n6\timport jline.lang.layered.Activity;\n7\timport jline.lang.layered.Entry;\n8\timport jline.lang.layered.LayeredNetwork;\n9\timport jline.lang.layered.Task;\n10\timport jline.lang.nodes.Delay;\n11\timport jline.lang.nodes.Node;\n12\timport jline.lang.nodes.Queue;\n13\timport jline.lang.processes.Exp;\n14\timport jline.io.Ret;\n15\timport jline.solvers.LayeredNetworkAvgTable;\n16\timport jline.solvers.ln_simple.mva.MvaInputs;\n17\timport jline.solvers.ln_simple.results.ResultsCollector;\n18\timport jline.util.matrix.Matrix;\n19\t\n20\timport java.util.HashMap;\n21\timport java.util.IdentityHashMap;\n22\timport java.util.List;\n23\timport java.util.Map;\n24\t\n25\t\n26\t/**\n27\t * Layered Queueing Network (LQN) decomposition solver.\n28\t *\n29\t * <h2>Decomposition model</h2>\n30\t * {@link LayeredNetwork#getEnsemble()} factors the LQN into a list of single-server\n31\t * closed PFQNs, one per processor and one per task. Two layer kinds are used:\n32\t *\n33\t * <ul>\n34\t *   <li><b>{@code T:<task>} task layer</b> — server queue is the task; closed\n35\t *       classes are caller tasks named {@code R:<caller>} with N = caller multiplicity\n36\t *       and demand = total call-demand (sum of {@code callMean × hostDemand} over\n37\t *       all synchronous calls into the task).</li>\n38\t *   <li><b>{@code P:<proc>} host layer</b> — server queue is the processor; classes\n39\t *       are either per-caller {@code R:<caller>} (multi-caller / rebuilt Case B) or\n40\t *       one aggregate {@code T:<task>} class (single-class form).</li>\n41\t * </ul>\n42\t *\n43\t * Each layer also has a {@code Clients} {@link Delay} node whose mean encodes the\n44\t * think / blocking time per class.\n45\t *\n46\t * <h2>Architecture</h2>\n47\t * Work is split across four files:\n48\t * <ul>\n49\t *   <li>{@link EnsembleInitialiser} — one-shot constructor-time init (demand fixing,\n50\t *       Case-B rebuild, population cap, topology snapshots).</li>\n51\t *   <li>This class — public API + the iteration loop and its two coupling stages.</li>\n52\t *   <li>{@link MvaInputs} — MVA matrix builders and the reflection-based call into\n53\t *       {@code pfqn_mvams}.</li>\n54\t *   <li>{@link LqnGraph} — pure read-only queries on the LQN model.</li>\n55\t *   <li>{@link ResultsCollector} (in {@code results/}) — final-pass result assembly\n56\t *       into a {@link LayeredNetworkAvgTable}.</li>\n57\t * </ul>\n58\t *\n59\t * <h2>Iteration</h2>\n60\t * {@link #iterateCoupledMva} runs a bounce sweep (sequence\n61\t * {@code 0,1,...,N-1,N-2,...,1}) over all layers per outer iteration so that\n62\t * information flows both ways through the call chain in a single pass. Each layer\n63\t * is solved by {@code pfqn_mvams}; its result then propagates into coupled\n64\t * layers via {@code Clients} think times and queue service rates. Stop when\n65\t * {@code max |ΔX| < tol}.\n66\t *\n67\t * <h2>Notation (used in comments throughout)</h2>\n68\t * D / L — service demand at a station; N — population; X — throughput;\n69\t * Q — mean queue length; R — response time (Q/X by Little's law);\n70\t * Z — Clients-delay (think) time; callMean — expected sync calls per caller-visit.\n71\t */\n72\tpublic class SolverLNSimple {\n73\t\n74\t    // === Numerical safety constants ===\n75\t    /** Minimum positive value used to avoid zero-divides. */\n76\t    private static final double EPS = 1e-12;\n77\t    /** Hard upper bound on injected think / service times. Keeps MVA inputs finite\n78\t     *  when feedback transiently blows up before convergence. */\n79\t    private static final double MAX_PROTECTION = 1e6;\n80\t    /** Floor for any clamped value (slightly larger than EPS so MVA always sees > 0). */\n81\t    private static final double CLAMP_FLOOR = 1e-9;\n82\t\n83\t    // === Model & ensemble ===\n84\t    private final LayeredNetwork lqnModel;\n85\t    private final List<Network> ensemble;\n86\t    private final int N_LAYERS;\n87\t\n88\t    // === Initialisation result (immutable for the lifetime of the solver) ===\n89\t    private final double[] baseClientsThink;\n90\t    private final Map<String, Integer> queueNameToLayer;\n91\t    private final Map<String, String> taskToProcessor;\n92\t    private final Map<Integer, String> rebuiltHostLayers;\n93\t\n94\t    // === State accumulated across sweeps ===\n95\t    /** Cached server-only response time per callee task (Q_server/X). Used by the\n96\t     *  cycle-time formula when updating intermediate callers' Clients delay. */\n97\t    private final Map<String, Double> taskSojournCache = new HashMap<String, Double>();\n98\t    /** Cached throughput per callee task. Companion to {@link #taskSojournCache}. */\n99\t    private final Map<String, Double> taskThroughputCache = new HashMap<String, Double>();\n100\t\n101\t    // === Topologically-invariant specialisation caches (one fill per solve) ===\n102\t    /** Per-(Network, taskName) result of {@link #findClassByTaskName}. A null\n103\t     *  match is itself cached, so {@code containsKey} is the miss probe. */\n104\t    private final IdentityHashMap<Network, Map<String, JobClass>> classByTaskCache = new IdentityHashMap<Network, Map<String, JobClass>>();\n105\t    /** Per-Network result of {@link #findActiveQueueClass}. Permits null values,\n106\t     *  so {@code containsKey} distinguishes \"computed null\" from \"absent\". */\n107\t    private final IdentityHashMap<Network, JobClass> activeQueueClassCache = new IdentityHashMap<Network, JobClass>();\n108\t    /** Per-task result of {@link #isInfOnMultiServerPs} (purely topological). */\n109\t    private final Map<String, Boolean> isInfOnMultiServerPsCache = new HashMap<String, Boolean>();\n110\t    /** Per-caller {calleeName → Σ actWeight·callMean} map for\n111\t     *  {@link #computeSiblingCalleeBlocking}. The map structure is graph-only;\n112\t     *  only the {@code excludedCallee} filter and the iteration-time sojourn\n113\t     *  reads vary per call, so it is built once and folded over thereafter. */\n114\t    private final Map<String, Map<String, Double>> siblingCallMeansCache = new HashMap<String, Map<String, Double>>();\n115\t\n116\t    /** Result table from the most recent {@link #iterateCoupledMva} run. */\n117\t    private LayeredNetworkAvgTable lastAvgTable;\n118\t\n119\t\n120\t    // =================================================================================\n121\t    //  Construction\n122\t    // =================================================================================\n123\t\n124\t    public SolverLNSimple(LayeredNetwork model) {\n125\t        this.lqnModel = model;\n126\t        this.ensemble = model.getEnsemble();\n127\t        this.N_LAYERS = ensemble.size();\n128\t\n129\t        EnsembleInitialiser.Result init = EnsembleInitialiser.initialise(model, ensemble);\n130\t        this.baseClientsThink   = init.baseClientsThink;\n131\t        this.queueNameToLayer   = init.queueNameToLayer;\n132\t        this.taskToProcessor    = init.taskToProcessor;\n133\t        this.rebuiltHostLayers  = init.rebuiltHostLayers;\n134\t\n135\t        // EnsembleInitialiser's Case-B rebuild adds per-caller R: classes to\n136\t        // existing host layers after snapshotBaselines/fixCallerClassDemands may\n137\t        // already have populated MvaInputs' per-layer cache. Drop those entries\n138\t        // so the iteration loop rebuilds them against the finished ensemble.\n139\t        MvaInputs.invalidateAllLayerCaches();\n140\t    }\n141\t\n142\t\n143\t    // =================================================================================\n144\t    //  Public API\n145\t    // =================================================================================\n146\t\n147\t    public LayeredNetworkAvgTable getAvgTable() {\n148\t        return lastAvgTable;\n149\t    }\n150\t\n151\t    public List<Network> getEnsemble() {\n152\t        return ensemble;\n153\t    }\n154\t\n155\t    public static final int DEFAULT_MAX_ITER = 100;\n156\t    public static final double DEFAULT_TOL = 5e-3;\n157\t\n158\t    /**\n159\t     * Limit-cycle detection thresholds for the outer fixed-point loop. When the\n160\t     * fixed-point iteration enters a 2-cycle (state alternating A,B,A,B,…),\n161\t     * maxDeltaX repeats to many digits and {@code maxDeltaX < tol} never fires,\n\n... [830 lines truncated] ..."},"type":"attachment","uuid":"d5442ac3-32ce-4deb-a886-1c3e78b8aeac","timestamp":"2026-06-09T23:30:32.279Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/alex/Documents/FYP/line-dev","sessionId":"367791ef-ba0c-4f75-943f-87a55717b89c","version":"2.1.168","gitBranch":"perf-port"}
{"parentUuid":"d5442ac3-32ce-4deb-a886-1c3e78b8aeac","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/alex/Documents/FYP/line-dev/jar/src/main/kotlin/jline/solvers/ln_simple/mva/MvaInputs.java","snippet":"1\tpackage jline.solvers.ln_simple.mva;\n2\t\n3\timport jline.io.Ret;\n4\timport jline.lang.ClosedClass;\n5\timport jline.lang.JobClass;\n6\timport jline.lang.Network;\n7\timport jline.lang.nodes.Delay;\n8\timport jline.lang.nodes.Node;\n9\timport jline.lang.nodes.Queue;\n10\timport jline.lang.nodes.ServiceStation;\n11\timport jline.lang.nodes.Station;\n12\timport jline.solvers.ln_simple.SolverLNSimple;\n13\timport jline.util.matrix.Matrix;\n14\t\n15\timport java.util.ArrayList;\n16\timport java.util.List;\n17\timport java.util.WeakHashMap;\n18\t\n19\t/**\n20\t * MVA matrix-builder utilities for {@link SolverLNSimple}.\n21\t *\n22\t * <p>Each ensemble layer is a two-node closed network (one {@code Clients} delay\n23\t * plus one queue). These helpers assemble the inputs to the backing\n24\t * {@code pfqn_mvams} routine:\n25\t * <ul>\n26\t *   <li>{@code L} — service-demand matrix at non-Delay stations</li>\n27\t *   <li>{@code N} — per-class population vector</li>\n28\t *   <li>{@code Z} — per-class think time from the {@code Clients} delay</li>\n29\t *   <li>{@code S} — per-station server counts ({@code Integer.MAX_VALUE} mapped to {@code N_total})</li>\n30\t * </ul>\n31\t */\n32\tpublic final class MvaInputs {\n33\t\n34\t    private MvaInputs() {}\n35\t\n36\t    // =================================================================================\n37\t    //  Per-Network structural cache\n38\t    //\n39\t    //  A layer's node list, closed-class set, server queue and Clients delay are\n40\t    //  fixed once EnsembleInitialiser.initialise(...) finishes — the solve only\n41\t    //  varies per-class service rates, never the layer shape. The solver\n42\t    //  re-queries this structure on every iteration, so it is computed once per\n43\t    //  Network and held behind a WeakHashMap, with a volatile most-recent pair\n44\t    //  as the lock-free fast path.\n45\t    //\n46\t    //  Invalidation: EnsembleInitialiser's Case-B rebuild adds caller classes to\n47\t    //  existing layers, which can happen after an early query already populated\n48\t    //  the cache. The SolverLNSimple constructor therefore calls\n49\t    //  {@link #invalidateAllLayerCaches()} once the ensemble is final, so the\n50\t    //  iteration loop always sees a cache built against the finished shape.\n51\t    // =================================================================================\n52\t    private static final WeakHashMap<Network, LayerInfo> LAYER_CACHE = new WeakHashMap<Network, LayerInfo>();\n53\t    private static volatile Network   lastLayer;\n54\t    private static volatile LayerInfo lastInfo;\n55\t\n56\t    private static final class LayerInfo {\n57\t        final List<Node>        mvaNodes      = new ArrayList<Node>();\n58\t        final List<ClosedClass> closed        = new ArrayList<ClosedClass>();\n59\t        JobClass                mainClass;\n60\t        Queue                   nonDelayQueue;\n61\t        Delay                   clientsDelay;\n62\t    }\n63\t\n64\t    private static LayerInfo infoFor(Network net) {\n65\t        if (net == lastLayer) {\n66\t            LayerInfo li = lastInfo;\n67\t            if (li != null) return li;\n68\t        }\n69\t        synchronized (LAYER_CACHE) {\n70\t            LayerInfo li = LAYER_CACHE.get(net);\n71\t            if (li == null) {\n72\t                li = computeLayerInfo(net);\n73\t                LAYER_CACHE.put(net, li);\n74\t            }\n75\t            lastLayer = net;\n76\t            lastInfo = li;\n77\t            return li;\n78\t        }\n79\t    }\n80\t\n81\t    private static LayerInfo computeLayerInfo(Network net) {\n82\t        LayerInfo li = new LayerInfo();\n83\t        // Delay extends Queue, so the two must be distinguished explicitly.\n84\t        for (Node node : net.getNodes()) {\n85\t            boolean isDelay = node instanceof Delay;\n86\t            if (!isDelay && !(node instanceof Queue)) continue;\n87\t            li.mvaNodes.add(node);\n88\t            if (isDelay) {\n89\t                if (li.clientsDelay == null && \"Clients\".equals(node.getName())) {\n90\t                    li.clientsDelay = (Delay) node;\n91\t                }\n92\t            } else if (li.nonDelayQueue == null) {\n93\t                li.nonDelayQueue = (Queue) node;\n94\t            }\n95\t        }\n96\t        for (JobClass jc : net.getClasses()) {\n97\t            if (jc instanceof ClosedClass && ((ClosedClass) jc).getNumberOfJobs() > 0) {\n98\t                li.closed.add((ClosedClass) jc);\n99\t            }\n100\t        }\n101\t        li.mainClass = li.closed.isEmpty() ? net.getClasses().get(0) : li.closed.get(0);\n102\t        return li;\n103\t    }\n104\t\n105\t    /** Drop the cached structure for one Network — for callers that legitimately\n106\t     *  re-shape a layer (e.g. EnsembleInitialiser's Case-B rebuild). */\n107\t    public static void invalidateLayerCache(Network net) {\n108\t        synchronized (LAYER_CACHE) {\n109\t            LAYER_CACHE.remove(net);\n110\t            if (lastLayer == net) { lastLayer = null; lastInfo = null; }\n111\t        }\n112\t    }\n113\t\n114\t    /** Drop every cached layer. Called once at the end of the SolverLNSimple\n115\t     *  constructor so the iteration loop never reuses an entry that was\n116\t     *  populated mid-initialise, before the Case-B rebuild added caller\n117\t     *  classes. */\n118\t    public static void invalidateAllLayerCaches() {\n119\t        synchronized (LAYER_CACHE) {\n120\t            LAYER_CACHE.clear();\n121\t            lastLayer = null;\n122\t            lastInfo = null;\n123\t        }\n124\t    }\n125\t\n126\t    /** All Queue and Delay nodes in {@code layer}, preserving network order. */\n127\t    public static List<Node> getQueueNodes(Network layer) {\n128\t        return infoFor(layer).mvaNodes;\n129\t    }\n130\t\n131\t    /** First closed class with positive population (the \"main\" class); falls back\n132\t     *  to the very first class of any kind when the layer has no active customers. */\n133\t    public static JobClass getMainClass(Network net) {\n134\t        return infoFor(net).mainClass;\n135\t    }\n136\t\n137\t    /** Closed classes with N &gt; 0. Classes with N = 0 are filtered so disabled\n138\t     *  classes (e.g. the aggregate-T class in rebuilt Case-B layers) do not appear\n139\t     *  in the MVA matrices. */\n140\t    public static List<ClosedClass> getClosedClasses(Network net) {\n141\t        return infoFor(net).closed;\n142\t    }\n143\t\n144\t    /** Cached {@code Delay} node named \"Clients\", or {@code null} if absent. */\n145\t    public static Delay findClientsDelay(Network net) {\n146\t        return infoFor(net).clientsDelay;\n147\t    }\n148\t\n149\t    /**\n150\t     * Build the {@code (numNodes × numClasses)} demand matrix L. Delay nodes get\n151\t     * demand 0 (their service time enters through Z, not L). For non-Delay\n152\t     * stations:\n153\t     * <ul>\n154\t     *   <li>Take the class's own service-process mean if it is not NaN.</li>\n155\t     *   <li>Otherwise fall back to the first non-NaN class's mean. This is a\n156\t     *       safety net for caller classes that the initialiser's demand-fix loop\n157\t     *       did not populate — a rare path, kept to avoid passing NaN to MVA.</li>\n158\t     * </ul>\n159\t     */\n160\t    public static Matrix buildDemandMatrix(List<Node> mvaNodes, Network net) {\n161\t        List<ClosedClass> closed = getClosedClasses(net);\n162\t        int m = mvaNodes.size();\n163\t        int R = closed.size();\n164\t        Matrix l = new Matrix(m, R);\n165\t        for (int r = 0; r < R; r++) {\n166\t            JobClass jc = closed.get(r);\n167\t            for (int i = 0; i < m; i++) {\n168\t                Node node = mvaNodes.get(i);\n169\t                double mean = 0.0;\n170\t                if (node instanceof ServiceStation && !(node instanceof Delay)) {\n171\t                    mean = ((ServiceStation) node).getServiceProcess(jc).getMean();\n172\t                    if (Double.isNaN(mean)) {\n173\t                        for (JobClass jc2 : net.getClasses()) {\n174\t                            double m2 = ((ServiceStation) node).getServiceProcess(jc2).getMean();\n175\t                            if (!Double.isNaN(m2)) { mean = m2; break; }\n176\t                        }\n177\t                        if (Double.isNaN(mean)) mean = 0.0;\n178\t                    }\n179\t                }\n180\t                l.set(i, r, mean);\n181\t            }\n182\t        }\n\n... [205 lines truncated] ..."},"type":"attachment","uuid":"6481fe01-9cd2-428e-9d1b-7e676e64f93c","timestamp":"2026-06-09T23:30:32.279Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/alex/Documents/FYP/line-dev","sessionId":"367791ef-ba0c-4f75-943f-87a55717b89c","version":"2.1.168","gitBranch":"perf-port"}
