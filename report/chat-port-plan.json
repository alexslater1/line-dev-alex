efix} for layer/class names.</li>\n42\t * </ul>\n43\t */\n44\tpublic final class LqnGraph {\n45\t\n46\t    private LqnGraph() {}\n47\t\n48\t    // =================================================================================\n49\t    //  Lookups\n50\t    // =================================================================================\n51\t\n52\t    /** First task with the given name, or {@code null}. */\n53\t    public static Task findTask(LayeredNetwork model, String name) {\n54\t        if (name == null) return null;\n55\t        for (Task t : model.getTasks().values()) {\n56\t            if (name.equals(t.getName())) return t;\n57\t        }\n58\t        return null;\n59\t    }\n60\t\n61\t    /** First entry with the given name, or {@code null}. */\n62\t    public static Entry findEntry(LayeredNetwork model, String name) {\n63\t        if (name == null) return null;\n64\t        for (Entry e : model.getEntries().values()) {\n65\t            if (name.equals(e.getName())) return e;\n66\t        }\n67\t        return null;\n68\t    }\n69\t\n70\t    /** Name of <i>any</i> task whose activities issue a sync call into a task\n71\t     *  named {@code calleeName}. Returns {@code null} if no caller exists. */\n72\t    public static String findCallerTask(LayeredNetwork model, String calleeName) {\n73\t        if (calleeName == null) return null;\n74\t        for (Task task : model.getTasks().values()) {\n75\t            for (Activity act : task.getActivities()) {\n76\t                for (String dest : act.getSyncCallDests().values()) {\n77\t                    Entry e = findEntry(model, dest);\n78\t                    if (e != null && e.getParent() != null\n79\t                            && calleeName.equals(e.getParent().getName())) {\n80\t                        return task.getName();\n81\t                    }\n82\t                }\n83\t            }\n84\t        }\n85\t        return null;\n86\t    }\n87\t\n88\t\n89\t    // =================================================================================\n90\t    //  Predicates\n91\t    // =================================================================================\n92\t\n93\t    public static boolean isRefTask(Task task) {\n94\t        return task != null && task.getScheduling() == SchedStrategy.REF;\n95\t    }\n96\t\n97\t    public static boolean isInfScheduledTask(LayeredNetwork model, String taskName) {\n98\t        Task t = findTask(model, taskName);\n99\t        return t != null && t.getScheduling() == SchedStrategy.INF;\n100\t    }\n101\t\n102\t    /** True iff the named host is INF-scheduled (true delay server, no queueing). */\n103\t    public static boolean isInfProcessor(LayeredNetwork model, String procName) {\n104\t        for (Host h : model.getHosts().values()) {\n105\t            if (h.getName().equals(procName)) {\n106\t                return h.getScheduling() == SchedStrategy.INF;\n107\t            }\n108\t        }\n109\t        return false;\n110\t    }\n111\t\n112\t    /** True iff {@code task} has at least one synchronous-call activity. */\n113\t    public static boolean taskHasSyncCallees(LayeredNetwork model, String taskName) {\n114\t        Task t = findTask(model, taskName);\n115\t        if (t == null) return false;\n116\t        for (Activity act : t.getActivities()) {\n117\t            Map<Integer, String> dests = act.getSyncCallDests();\n118\t            if (dests != null && !dests.isEmpty()) return true;\n119\t        }\n120\t        return false;\n121\t    }\n122\t\n123\t    /** True iff {@code task} synchronously calls two or more <i>distinct</i> callee\n124\t     *  tasks (i.e. fans out). Single-callee callers do not need sibling-callee\n125\t     *  accounting or Z-update damping. */\n126\t    public static boolean callerFansOut(LayeredNetwork model, String taskName) {\n127\t        Task t = findTask(model, taskName);\n128\t        if (t == null) return false;\n129\t        Set<String> distinctCallees = new HashSet<String>();\n130\t        for (Activity act : t.getActivities()) {\n131\t            Map<Integer, String> dests = act.getSyncCallDests();\n132\t            if (dests == null) continue;\n133\t            for (String dest : dests.values()) {\n134\t                Entry e = findEntry(model, dest);\n135\t                if (e == null || e.getParent() == null) continue;\n136\t                String calleeName = e.getParent().getName();\n137\t                if (taskName.equals(calleeName)) continue;\n138\t                distinctCallees.add(calleeName);\n139\t                if (distinctCallees.size() > 1) return true;\n140\t            }\n141\t        }\n142\t        return false;\n143\t    }\n144\t\n145\t    /** True iff {@code task} contains an AND_FORK→AND_JOIN region inside one\n146\t     *  of its entries' activity DAG. Used by host-layer coupling to skip\n147\t     *  overwriting T:-layer D (which holds caller-perceived MAX) with the\n148\t     *  host's processor SUM. */\n149\t    public static boolean taskHasAndFork(LayeredNetwork model, String taskName) {\n150\t        Task t = findTask(model, taskName);\n151\t        if (t == null) return false;\n152\t        List<ActivityPrecedence> precs = t.getPrecedences();\n153\t        if (precs == null) return false;\n154\t        for (ActivityPrecedence p : precs) {\n155\t            if (ActivityPrecedenceType.POST_AND.equals(p.getPostType())) {\n156\t                List<String> post = p.getPostActs();\n157\t                if (post != null && post.size() >= 2) return true;\n158\t            }\n159\t        }\n160\t        return false;\n161\t    }\n162\t\n163\t    /** True iff {@code task} or any (recursive) sync callee has positive host demand. */\n164\t    public static boolean hasServerDemandInSubtree(LayeredNetwork model, String taskName) {\n165\t        return hasServerDemandInSubtreeImpl(model, taskName, new HashSet<String>());"}]},"uuid":"fb37cf2e-f120-4905-bec8-fff54087b37f","timestamp":"2026-06-09T22:38:15.608Z","toolUseResult":{"type":"text","file":{"filePath":"/home/alex/Documents/FYP/line-dev/jar/src/main/kotlin/jline/solvers/ln_simple/LqnGraph.java","content":"package jline.solvers.ln_simple;\n\nimport jline.lang.constant.ActivityPrecedenceType;\nimport jline.lang.constant.SchedStrategy;\nimport jline.lang.layered.Activity;\nimport jline.lang.layered.ActivityPrecedence;\nimport jline.lang.layered.Entry;\nimport jline.lang.layered.Host;\nimport jline.lang.layered.LayeredNetwork;\nimport jline.lang.layered.Task;\nimport jline.util.matrix.Matrix;\n\nimport java.util.ArrayDeque;\nimport java.util.ArrayList;\nimport java.util.Deque;\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\n/**\n * Pure read-only queries on a {@link LayeredNetwork} model.\n *\n * <p>Every method here is stateless and idempotent — it computes a value or\n * traverses the LQN graph without mutating anything. Shared between\n * {@link SolverLNSimple} (during iteration and coupling) and\n * {@link jline.solvers.ln_simple.results.ResultsCollector} (during final\n * table assembly).\n *\n * <p>Method families:\n * <ul>\n *   <li><b>Lookups</b> — find by name: {@link #findTask}, {@link #findEntry},\n *       {@link #findCallerTask}.</li>\n *   <li><b>Predicates</b> — boolean tests: {@link #isRefTask},\n *       {@link #isInfScheduledTask}, {@link #taskHasSyncCallees}, etc.</li>\n *   <li><b>Quantities</b> — numerical traversals: demands, call means,\n *       think times, chain sums.</li>\n *   <li><b>Caller maps</b> — graph-wide maps used by results assembly:\n *       {@link #buildTaskCalledTaskMap}, {@link #buildRefTaskCalledTaskMap}.</li>\n *   <li><b>String</b> — {@link #stripPrefix} for layer/class names.</li>\n * </ul>\n */\npublic final class LqnGraph {\n\n    private LqnGraph() {}\n\n    // =================================================================================\n    //  Lookups\n    // =================================================================================\n\n    /** First task with the given name, or {@code null}. */\n    public static Task findTask(LayeredNetwork model, String name) {\n        if (name == null) return null;\n        for (Task t : model.getTasks().values()) {\n            if (name.equals(t.getName())) return t;\n        }\n        return null;\n    }\n\n    /** First entry with the given name, or {@code null}. */\n    public static Entry findEntry(LayeredNetwork model, String name) {\n        if (name == null) return null;\n        for (Entry e : model.getEntries().values()) {\n            if (name.equals(e.getName())) return e;\n        }\n        return null;\n    }\n\n    /** Name of <i>any</i> task whose activities issue a sync call into a task\n     *  named {@code calleeName}. Returns {@code null} if no caller exists. */\n    public static String findCallerTask(LayeredNetwork model, String calleeName) {\n        if (calleeName == null) return null;\n        for (Task task : model.getTasks().values()) {\n            for (Activity act : task.getActivities()) {\n                for (String dest : act.getSyncCallDests().values()) {\n                    Entry e = findEntry(model, dest);\n                    if (e != null && e.getParent() != null\n                            && calleeName.equals(e.getParent().getName())) {\n                        return task.getName();\n                    }\n                }\n            }\n        }\n        return null;\n    }\n\n\n    // =================================================================================\n    //  Predicates\n    // =================================================================================\n\n    public static boolean isRefTask(Task task) {\n        return task != null && task.getScheduling() == SchedStrategy.REF;\n    }\n\n    public static boolean isInfScheduledTask(LayeredNetwork model, String taskName) {\n        Task t = findTask(model, taskName);\n        return t != null && t.getScheduling() == SchedStrategy.INF;\n    }\n\n    /** True iff the named host is INF-scheduled (true delay server, no queueing). */\n    public static boolean isInfProcessor(LayeredNetwork model, String procName) {\n        for (Host h : model.getHosts().values()) {\n            if (h.getName().equals(procName)) {\n                return h.getScheduling() == SchedStrategy.INF;\n            }\n        }\n        return false;\n    }\n\n    /** True iff {@code task} has at least one synchronous-call activity. */\n    public static boolean taskHasSyncCallees(LayeredNetwork model, String taskName) {\n        Task t = findTask(model, taskName);\n        if (t == null) return false;\n        for (Activity act : t.getActivities()) {\n            Map<Integer, String> dests = act.getSyncCallDests();\n            if (dests != null && !dests.isEmpty()) return true;\n        }\n        return false;\n    }\n\n    /** True iff {@code task} synchronously calls two or more <i>distinct</i> callee\n     *  tasks (i.e. fans out). Single-callee callers do not need sibling-callee\n     *  accounting or Z-update damping. */\n    public static boolean callerFansOut(LayeredNetwork model, String taskName) {\n        Task t = findTask(model, taskName);\n        if (t == null) return false;\n        Set<String> distinctCallees = new HashSet<String>();\n        for (Activity act : t.getActivities()) {\n            Map<Integer, String> dests = act.getSyncCallDests();\n            if (dests == null) continue;\n            for (String dest : dests.values()) {\n                Entry e = findEntry(model, dest);\n                if (e == null || e.getParent() == null) continue;\n                String calleeName = e.getParent().getName();\n                if (taskName.equals(calleeName)) continue;\n                distinctCallees.add(calleeName);\n                if (distinctCallees.size() > 1) return true;\n            }\n        }\n        return false;\n    }\n\n    /** True iff {@code task} contains an AND_FORK→AND_JOIN region inside one\n     *  of its entries' activity DAG. Used by host-layer coupling to skip\n     *  overwriting T:-layer D (which holds caller-perceived MAX) with the\n     *  host's processor SUM. */\n    public static boolean taskHasAndFork(LayeredNetwork model, String taskName) {\n        Task t = findTask(model, taskName);\n        if (t == null) return false;\n        List<ActivityPrecedence> precs = t.getPrecedences();\n        if (precs == null) return false;\n        for (ActivityPrecedence p : precs) {\n            if (ActivityPrecedenceType.POST_AND.equals(p.getPostType())) {\n                List<String> post = p.getPostActs();\n                if (post != null && post.size() >= 2) return true;\n            }\n        }\n        return false;\n    }\n\n    /** True iff {@code task} or any (recursive) sync callee has positive host demand. */\n    public static boolean hasServerDemandInSubtree(LayeredNetwork model, String taskName) {\n        return hasServerDemandInSubtreeImpl(model, taskName, new HashSet<String>());","numLines":165,"startLine":1,"totalLines":1050}},"sourceToolAssistantUUID":"c3439de3-7e3c-4900-8fd6-3f0a3f09ceca","userType":"external","entrypoint":"claude-vscode","cwd":"/home/alex/Documents/FYP/line-dev","sessionId":"367791ef-ba0c-4f75-943f-87a55717b89c","version":"2.1.168","gitBranch":"perf-port"}
