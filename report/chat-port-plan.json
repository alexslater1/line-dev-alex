{"parentUuid":"444d285b-d824-421f-a869-778db3b2b276","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/alex/Documents/FYP/line-dev/jar/src/main/kotlin/jline/solvers/ln_simple/SolverLNSimple.java","snippet":"1\tpackage jline.solvers.ln_simple;\n2\t\n3\timport jline.lang.ClosedClass;\n4\timport jline.lang.JobClass;\n5\timport jline.lang.Network;\n6\timport jline.lang.layered.Activity;\n7\timport jline.lang.layered.Entry;\n8\timport jline.lang.layered.LayeredNetwork;\n9\timport jline.lang.layered.Task;\n10\timport jline.lang.nodes.Delay;\n11\timport jline.lang.nodes.Node;\n12\timport jline.lang.nodes.Queue;\n13\timport jline.lang.processes.Exp;\n14\timport jline.io.Ret;\n15\timport jline.solvers.LayeredNetworkAvgTable;\n16\timport jline.solvers.ln_simple.mva.MvaInputs;\n17\timport jline.solvers.ln_simple.results.ResultsCollector;\n18\timport jline.util.matrix.Matrix;\n19\t\n20\timport java.util.HashMap;\n21\timport java.util.List;\n22\timport java.util.Map;\n23\t\n24\t\n25\t/**\n26\t * Layered Queueing Network (LQN) decomposition solver.\n27\t *\n28\t * <h2>Decomposition model</h2>\n29\t * {@link LayeredNetwork#getEnsemble()} factors the LQN into a list of single-server\n30\t * closed PFQNs, one per processor and one per task. Two layer kinds are used:\n31\t *\n32\t * <ul>\n33\t *   <li><b>{@code T:<task>} task layer</b> — server queue is the task; closed\n34\t *       classes are caller tasks named {@code R:<caller>} with N = caller multiplicity\n35\t *       and demand = total call-demand (sum of {@code callMean × hostDemand} over\n36\t *       all synchronous calls into the task).</li>\n37\t *   <li><b>{@code P:<proc>} host layer</b> — server queue is the processor; classes\n38\t *       are either per-caller {@code R:<caller>} (multi-caller / rebuilt Case B) or\n39\t *       one aggregate {@code T:<task>} class (single-class form).</li>\n40\t * </ul>\n41\t *\n42\t * Each layer also has a {@code Clients} {@link Delay} node whose mean encodes the\n43\t * think / blocking time per class.\n44\t *\n45\t * <h2>Architecture</h2>\n46\t * Work is split across four files:\n47\t * <ul>\n48\t *   <li>{@link EnsembleInitialiser} — one-shot constructor-time init (demand fixing,\n49\t *       Case-B rebuild, population cap, topology snapshots).</li>\n50\t *   <li>This class — public API + the iteration loop and its two coupling stages.</li>\n51\t *   <li>{@link MvaInputs} — MVA matrix builders and the reflection-based call into\n52\t *       {@code pfqn_mvams}.</li>\n53\t *   <li>{@link LqnGraph} — pure read-only queries on the LQN model.</li>\n54\t *   <li>{@link ResultsCollector} (in {@code results/}) — final-pass result assembly\n55\t *       into a {@link LayeredNetworkAvgTable}.</li>\n56\t * </ul>\n57\t *\n58\t * <h2>Iteration</h2>\n59\t * {@link #iterateCoupledMva} runs a bounce sweep (sequence\n60\t * {@code 0,1,...,N-1,N-2,...,1}) over all layers per outer iteration so that\n61\t * information flows both ways through the call chain in a single pass. Each layer\n62\t * is solved by {@code pfqn_mvams}; its result then propagates into coupled\n63\t * layers via {@code Clients} think times and queue service rates. Stop when\n64\t * {@code max |ΔX| < tol}.\n65\t *\n66\t * <h2>Notation (used in comments throughout)</h2>\n67\t * D / L — service demand at a station; N — population; X — throughput;\n68\t * Q — mean queue length; R — response time (Q/X by Little's law);\n69\t * Z — Clients-delay (think) time; callMean — expected sync calls per caller-visit.\n70\t */\n71\tpublic class SolverLNSimple {\n72\t\n73\t    // === Numerical safety constants ===\n74\t    /** Minimum positive value used to avoid zero-divides. */\n75\t    private static final double EPS = 1e-12;\n76\t    /** Hard upper bound on injected think / service times. Keeps MVA inputs finite\n77\t     *  when feedback transiently blows up before convergence. */\n78\t    private static final double MAX_PROTECTION = 1e6;\n79\t    /** Floor for any clamped value (slightly larger than EPS so MVA always sees > 0). */\n80\t    private static final double CLAMP_FLOOR = 1e-9;\n81\t\n82\t    // === Model & ensemble ===\n83\t    private final LayeredNetwork lqnModel;\n84\t    private final List<Network> ensemble;\n85\t    private final int N_LAYERS;\n86\t\n87\t    // === Initialisation result (immutable for the lifetime of the solver) ===\n88\t    private final double[] baseClientsThink;\n89\t    private final Map<String, Integer> queueNameToLayer;\n90\t    private final Map<String, String> taskToProcessor;\n91\t    private final Map<Integer, String> rebuiltHostLayers;\n92\t\n93\t    // === State accumulated across sweeps ===\n94\t    /** Cached server-only response time per callee task (Q_server/X). Used by the\n95\t     *  cycle-time formula when updating intermediate callers' Clients delay. */\n96\t    private final Map<String, Double> taskSojournCache = new HashMap<String, Double>();\n97\t    /** Cached throughput per callee task. Companion to {@link #taskSojournCache}. */\n98\t    private final Map<String, Double> taskThroughputCache = new HashMap<String, Double>();\n99\t\n100\t    /** Result table from the most recent {@link #iterateCoupledMva} run. */\n101\t    private LayeredNetworkAvgTable lastAvgTable;\n102\t\n103\t\n104\t    // =================================================================================\n105\t    //  Construction\n106\t    // =================================================================================\n107\t\n108\t    public SolverLNSimple(LayeredNetwork model) {\n109\t        this.lqnModel = model;\n110\t        this.ensemble = model.getEnsemble();\n111\t        this.N_LAYERS = ensemble.size();\n112\t\n113\t        EnsembleInitialiser.Result init = EnsembleInitialiser.initialise(model, ensemble);\n114\t        this.baseClientsThink   = init.baseClientsThink;\n115\t        this.queueNameToLayer   = init.queueNameToLayer;\n116\t        this.taskToProcessor    = init.taskToProcessor;\n117\t        this.rebuiltHostLayers  = init.rebuiltHostLayers;\n118\t    }\n119\t\n120\t\n121\t    // =================================================================================\n122\t    //  Public API\n123\t    // =================================================================================\n124\t\n125\t    public LayeredNetworkAvgTable getAvgTable() {\n126\t        return lastAvgTable;\n127\t    }\n128\t\n129\t    public List<Network> getEnsemble() {\n130\t        return ensemble;\n131\t    }\n132\t\n133\t    public static final int DEFAULT_MAX_ITER = 100;\n134\t    public static final double DEFAULT_TOL = 5e-3;\n135\t\n136\t    /**\n137\t     * Limit-cycle detection thresholds for the outer fixed-point loop. When the\n138\t     * fixed-point iteration enters a 2-cycle (state alternating A,B,A,B,…),\n139\t     * maxDeltaX repeats to many digits and {@code maxDeltaX < tol} never fires,\n140\t     * so the solver previously ran all the way to maxIter (e.g. chainPlusFanout\n141\t     * at 100 iters). Detecting the cycle lets it stop early at the most recent\n142\t     * state, which empirically stays within the project's standard tolerance vs\n143\t     * SolverLN/SolverLQNS.\n144\t     *\n145\t     * <p>Rule: if {@code |Δ_k − Δ_{k−1}| / max(Δ_k, ε) < LIMIT_CYCLE_REL} for\n146\t     * {@code LIMIT_CYCLE_WINDOW} consecutive iters while Δ_k is past the initial\n147\t     * transient ({@code Δ_k < LIMIT_CYCLE_DELTA_CAP}), declare limit-cycle\n148\t     * convergence and break.\n149\t     */\n150\t    private static final int    LIMIT_CYCLE_WINDOW    = 3;\n151\t    private static final double LIMIT_CYCLE_REL        = 1e-4;\n152\t    private static final double LIMIT_CYCLE_DELTA_CAP  = 10.0;\n153\t\n154\t    public void iterateCoupledMva() {\n155\t        iterateCoupledMva(DEFAULT_MAX_ITER, DEFAULT_TOL, null);\n156\t    }\n157\t\n158\t    public void iterateCoupledMva(Runnable afterIteration) {\n159\t        iterateCoupledMva(DEFAULT_MAX_ITER, DEFAULT_TOL, afterIteration);\n160\t    }\n161\t\n162\t    public void iterateCoupledMva(int maxIter, double tol) {\n163\t        iterateCoupledMva(maxIter, tol, null);\n164\t    }\n165\t\n166\t    /**\n167\t     * Outer fixed-point loop. Each outer iteration runs a bounce sweep over all\n168\t     * layers (index sequence {@code 0,1,...,N-1,N-2,...,1}) so that information\n169\t     * flows both ways through the call chain in a single pass. Convergence:\n170\t     * {@code max_l |X_l^(k) - X_l^(k-1)| < tol}.\n171\t     */\n172\t    public void iterateCoupledMva(int maxIter, double tol, Runnable afterIteration) {\n173\t        long outerStartTime = System.nanoTime();\n174\t        double[][] prevX = new double[N_LAYERS][];\n175\t\n176\t        double prevMaxDelta = Double.NaN;\n\n... [755 lines truncated] ..."},"type":"attachment","uuid":"0abf5d55-6742-4b4c-83ab-ba437f81baba","timestamp":"2026-06-09T23:11:10.758Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/alex/Documents/FYP/line-dev","sessionId":"367791ef-ba0c-4f75-943f-87a55717b89c","version":"2.1.168","gitBranch":"HEAD"}
{"parentUuid":"0abf5d55-6742-4b4c-83ab-ba437f81baba","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/home/alex/Documents/FYP/line-dev/jar/src/main/kotlin/jline/solvers/ln_simple/mva/MvaInputs.java","snippet":"1\tpackage jline.solvers.ln_simple.mva;\n2\t\n3\timport jline.io.Ret;\n4\timport jline.lang.ClosedClass;\n5\timport jline.lang.JobClass;\n6\timport jline.lang.Network;\n7\timport jline.lang.nodes.Delay;\n8\timport jline.lang.nodes.Node;\n9\timport jline.lang.nodes.Queue;\n10\timport jline.lang.nodes.ServiceStation;\n11\timport jline.lang.nodes.Station;\n12\timport jline.solvers.ln_simple.SolverLNSimple;\n13\timport jline.util.matrix.Matrix;\n14\t\n15\timport java.util.ArrayList;\n16\timport java.util.List;\n17\t\n18\t/**\n19\t * MVA matrix-builder utilities for {@link SolverLNSimple}.\n20\t *\n21\t * <p>Each ensemble layer is a two-node closed network (one {@code Clients} delay\n22\t * plus one queue). These helpers assemble the inputs to the backing\n23\t * {@code pfqn_mvams} routine:\n24\t * <ul>\n25\t *   <li>{@code L} — service-demand matrix at non-Delay stations</li>\n26\t *   <li>{@code N} — per-class population vector</li>\n27\t *   <li>{@code Z} — per-class think time from the {@code Clients} delay</li>\n28\t *   <li>{@code S} — per-station server counts ({@code Integer.MAX_VALUE} mapped to {@code N_total})</li>\n29\t * </ul>\n30\t */\n31\tpublic final class MvaInputs {\n32\t\n33\t    private MvaInputs() {}\n34\t\n35\t    /** All Queue and Delay nodes in {@code layer}, preserving network order. */\n36\t    public static List<Node> getQueueNodes(Network layer) {\n37\t        List<Node> nodes = new ArrayList<Node>();\n38\t        for (Node node : layer.getNodes()) {\n39\t            if (node instanceof Queue || node instanceof Delay) {\n40\t                nodes.add(node);\n41\t            }\n42\t        }\n43\t        return nodes;\n44\t    }\n45\t\n46\t    /** First closed class with positive population (the \"main\" class); falls back\n47\t     *  to the very first class of any kind when the layer has no active customers. */\n48\t    public static JobClass getMainClass(Network net) {\n49\t        for (JobClass jc : net.getClasses()) {\n50\t            if (jc instanceof ClosedClass && ((ClosedClass) jc).getNumberOfJobs() > 0) {\n51\t                return jc;\n52\t            }\n53\t        }\n54\t        return net.getClasses().get(0);\n55\t    }\n56\t\n57\t    /** Closed classes with N &gt; 0. Classes with N = 0 are filtered so disabled\n58\t     *  classes (e.g. the aggregate-T class in rebuilt Case-B layers) do not appear\n59\t     *  in the MVA matrices. */\n60\t    public static List<ClosedClass> getClosedClasses(Network net) {\n61\t        List<ClosedClass> result = new ArrayList<ClosedClass>();\n62\t        for (JobClass jc : net.getClasses()) {\n63\t            if (jc instanceof ClosedClass && ((ClosedClass) jc).getNumberOfJobs() > 0) {\n64\t                result.add((ClosedClass) jc);\n65\t            }\n66\t        }\n67\t        return result;\n68\t    }\n69\t\n70\t    /**\n71\t     * Build the {@code (numNodes × numClasses)} demand matrix L. Delay nodes get\n72\t     * demand 0 (their service time enters through Z, not L). For non-Delay\n73\t     * stations:\n74\t     * <ul>\n75\t     *   <li>Take the class's own service-process mean if it is not NaN.</li>\n76\t     *   <li>Otherwise fall back to the first non-NaN class's mean. This is a\n77\t     *       safety net for caller classes that the initialiser's demand-fix loop\n78\t     *       did not populate — a rare path, kept to avoid passing NaN to MVA.</li>\n79\t     * </ul>\n80\t     */\n81\t    public static Matrix buildDemandMatrix(List<Node> mvaNodes, Network net) {\n82\t        List<ClosedClass> closed = getClosedClasses(net);\n83\t        int m = mvaNodes.size();\n84\t        int R = closed.size();\n85\t        Matrix l = new Matrix(m, R);\n86\t        for (int r = 0; r < R; r++) {\n87\t            JobClass jc = closed.get(r);\n88\t            for (int i = 0; i < m; i++) {\n89\t                Node node = mvaNodes.get(i);\n90\t                double mean = 0.0;\n91\t                if (node instanceof ServiceStation && !(node instanceof Delay)) {\n92\t                    mean = ((ServiceStation) node).getServiceProcess(jc).getMean();\n93\t                    if (Double.isNaN(mean)) {\n94\t                        for (JobClass jc2 : net.getClasses()) {\n95\t                            double m2 = ((ServiceStation) node).getServiceProcess(jc2).getMean();\n96\t                            if (!Double.isNaN(m2)) { mean = m2; break; }\n97\t                        }\n98\t                        if (Double.isNaN(mean)) mean = 0.0;\n99\t                    }\n100\t                }\n101\t                l.set(i, r, mean);\n102\t            }\n103\t        }\n104\t        return l;\n105\t    }\n106\t\n107\t    /** Row vector of class populations. */\n108\t    public static Matrix buildN(Network net) {\n109\t        List<ClosedClass> closed = getClosedClasses(net);\n110\t        if (closed.isEmpty()) throw new IllegalArgumentException(\"No closed class with positive jobs\");\n111\t        Matrix n = new Matrix(1, closed.size());\n112\t        for (int r = 0; r < closed.size(); r++) {\n113\t            n.set(0, r, closed.get(r).getNumberOfJobs());\n114\t        }\n115\t        return n;\n116\t    }\n117\t\n118\t    /** Per-station server count. Infinite-server stations\n119\t     *  ({@code Integer.MAX_VALUE}) are mapped to total population so the MVA\n120\t     *  backend treats them as IS, not as a single-server FCFS. */\n121\t    public static Matrix buildServerMatrix(List<Node> mvaNodes, Matrix n) {\n122\t        int m = mvaNodes.size();\n123\t        Matrix s = new Matrix(m, 1);\n124\t        double ntot = 0.0;\n125\t        for (int r = 0; r < n.getNumCols(); r++) ntot += n.get(0, r);\n126\t        if (ntot < 1.0) ntot = 1.0;\n127\t        for (int i = 0; i < m; i++) {\n128\t            Node node = mvaNodes.get(i);\n129\t            double servers = 1.0;\n130\t            if (node instanceof Station) {\n131\t                int nserv = ((Station) node).getNumberOfServers();\n132\t                servers = (nserv == Integer.MAX_VALUE) ? ntot : (double) nserv;\n133\t            }\n134\t            s.set(i, 0, servers);\n135\t        }\n136\t        return s;\n137\t    }\n138\t\n139\t    /** Row vector Z of per-class think times read from the layer's\n140\t     *  {@code Clients} delay node. NaN means are treated as 0. */\n141\t    public static Matrix buildThinkTimeMatrix(Network net) {\n142\t        List<ClosedClass> closed = getClosedClasses(net);\n143\t        int R = closed.size();\n144\t        Matrix z = new Matrix(1, R);\n145\t        for (Node node : net.getNodes()) {\n146\t            if (node instanceof Delay && \"Clients\".equals(node.getName())) {\n147\t                for (int r = 0; r < R; r++) {\n148\t                    double mean = ((Delay) node).getServiceProcess(closed.get(r)).getMean();\n149\t                    z.set(0, r, Double.isNaN(mean) ? 0.0 : mean);\n150\t                }\n151\t                break;\n152\t            }\n153\t        }\n154\t        return z;\n155\t    }\n156\t\n157\t    /**\n158\t     * Threshold on {@code prodN = ∏(N_r + 1)} above which {@link #callMVA}\n159\t     * stops using exact LD-MVA ({@link MvaLd}) and falls back to Seidmann\n160\t     * multi-server AMVA ({@link MvaAmva}). Exact MVA's cost grows roughly like\n161\t     * {@code prodN · Nsum}; AMVA cost is independent of {@code prodN}.\n162\t     *\n163\t     * <p>Mutable so characterisation tests can drive different values; production\n164\t     * callers should leave it at its default.\n165\t     */\n166\t    public static volatile long exactLatticeMax = 500L;\n167\t\n168\t    /** Per-path dispatch counters. Tests reset before a solve and read after to\n169\t     *  see which paths actually fired on a given model. Plain (non-atomic)\n170\t     *  fields — {@code SolverLNSimple} is single-threaded. */\n171\t    public static long ldCalls = 0L;\n172\t    public static long amvaCalls = 0L;\n173\t\n174\t    public static void resetDispatchCounters() {\n175\t        ldCalls = 0L; amvaCalls = 0L;\n176\t    }\n177\t\n178\t    /**\n179\t     * Solve a layer's two-station closed network.\n180\t     *\n181\t     * <p>Three structural cases:\n182\t     * <ul>\n183\t     *   <li><b>Pure-IS layer</b> (e.g. {@code T:<inf-task>}) — no contention\n184\t     *       anywhere, return the closed-form\n185\t     *       {@code X[r] = N[r] / Z_eff[r], Q[i,r] = X[r] · L[i,r]} directly.</li>\n186\t     *   <li><b>{@code prodN > }{@link #exactLatticeMax}</b> → {@link MvaAmva}\n\n... [131 lines truncated] ..."},"type":"attachment","uuid":"0a9aa5e9-f89e-47cf-a728-d45a7b1ff2c0","timestamp":"2026-06-09T23:11:10.759Z","userType":"external","entrypoint":"claude-vscode","cwd":"/home/alex/Documents/FYP/line-dev","sessionId":"367791ef-ba0c-4f75-943f-87a55717b89c","version":"2.1.168","gitBranch":"HEAD"}
