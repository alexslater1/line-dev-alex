.entrySet()) {\n518\t                Entry destEntry = LqnGraph.findEntry(lqnModel, e.getValue());\n519\t                if (destEntry == null || destEntry.getParent() == null) continue;\n520\t                String calleeName = destEntry.getParent().getName();\n521\t                if (calleeName.equals(excludedCallee) || calleeName.equals(callerTask)) continue;\n522\t                int idx = e.getKey();\n523\t                double cMean = (means != null && means.getNumCols() > idx) ? means.get(0, idx) : 1.0;\n524\t                if (!Double.isFinite(cMean) || cMean <= 0) cMean = 1.0;\n525\t                double weighted = actWeight * cMean;\n526\t                Double accum = siblingCallMean.get(calleeName);\n527\t                siblingCallMean.put(calleeName, (accum != null ? accum : 0.0) + weighted);\n528\t            }\n529\t        }\n530\t        double total = 0.0;\n531\t        for (Map.Entry<String, Double> e : siblingCallMean.entrySet()) {\n532\t            String sibling = e.getKey();\n533\t            double cMean = e.getValue();\n534\t            Double rCached = taskSojournCache.get(sibling);\n535\t            double rContrib;\n536\t            if (rCached != null && Double.isFinite(rCached) && rCached > 0) {\n537\t                rContrib = LqnGraph.taskHasSyncCallees(lqnModel, sibling)\n538\t                        ? rCached * cMean : rCached;\n539\t            } else {\n540\t                rContrib = cMean * LqnGraph.computeLocalDemand(lqnModel, sibling);\n541\t            }\n542\t            total += rContrib;\n543\t        }\n544\t        return total;\n545\t    }\n546\t\n547\t    /** Step (2): keep the caller's own T: layer Clients up-to-date with the\n548\t     *  cumulative blocking the caller has experienced. */\n549\t    private void updateCallerOwnTaskLayerClients(int currentLayerIdx, String callerTask) {\n550\t        Integer callerTaskLayer = queueNameToLayer.get(\"T:\" + callerTask);\n551\t        if (callerTaskLayer == null || ca