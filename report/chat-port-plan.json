              maxDeltaX = Math.max(maxDeltaX, updateDeltaX(prevX, l, s.res));\n171\t\n172\t                if (s.isTaskLayer)      propagateTaskLayerCoupling(l, s);\n173\t                else if (s.isHostLayer) propagateHostLayerCoupling(l, s);\n174\t            }\n175\t\n176\t            double solveTime = (System.nanoTime() - solveStartTime) / 1e9;\n177\t            long synchStartTime = System.nanoTime();\n178\t            if (afterIteration != null) afterIteration.run();\n179\t            double synchTime = (System.nanoTime() - synchStartTime) / 1e9;\n180\t            double totalRuntime = (System.nanoTime() - outerStartTime) / 1e9;\n181\t\n182\t            System.out.printf(\"\\nIter %2d. Analyze time: %.3fs. Update time: %.3fs. Runtime: %.3fs. \",\n183\t                    iter + 1, solveTime, synchTime, totalRuntime);\n184\t\n185\t            if (maxDeltaX < tol) break;\n186\t        }\n187\t\n188\t        lastAvgTable = ResultsCollector.collectAndPrintFinalResults(\n189\t                lqnModel, ensemble, N_LAYERS, taskSojournCache, rebuiltHostLayers);\n190\t    }\n191\t\n192\t\n193\t    // =================================================================================\n194\t    //  Per-layer solve\n195\t    // =================================================================================\n196\t\n197\t    /** Bundles a single layer's MVA result with the surrounding context the\n198\t     *  coupling stages need. */\n199\t    private static final class LayerSolve {\n200\t        final Network layer;\n201\t        final Matrix N;\n202\t        final Matrix L;\n203\t        final Ret.pfqnMVA res;\n204\t        final Queue serverQueue;\n205\t        final int serverIdx;            // index of the (single) non-Delay queue in MVA nodes\n206\t        final boolean isTaskLayer;      // server name starts with \"T:\"\n207\t        final boolean isHostLayer;      // server name starts with \"P:\"\n208\t\n209\t        LayerSolve(Network layer, Matrix N, Matrix L,