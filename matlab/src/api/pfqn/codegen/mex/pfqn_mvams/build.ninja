# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2025a
startdir = /home/gcasale/Dropbox/code/line-dev.git/matlab/src/api/pfqn

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=pfqn_mvams_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=pfqn_mvams_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o pfqn_mvams_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_mvams.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o pfqn_mvams_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_mvams.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/pfqn_mvams_data.o : cc $root/pfqn_mvams_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/pfqn_mvams_initialize.o : cc $root/pfqn_mvams_initialize.c
build $builddir/pfqn_mvams_terminate.o : cc $root/pfqn_mvams_terminate.c
build $builddir/pfqn_mvams.o : cc $root/pfqn_mvams.c
build $builddir/ixfun.o : cc $root/ixfun.c
build $builddir/error.o : cc $root/error.c
build $builddir/sum.o : cc $root/sum.c
build $builddir/repmat.o : cc $root/repmat.c
build $builddir/assertCompatibleDims.o : cc $root/assertCompatibleDims.c
build $builddir/pfqn_mva.o : cc $root/pfqn_mva.c
build $builddir/any.o : cc $root/any.c
build $builddir/prod.o : cc $root/prod.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/ifWhileCond.o : cc $root/ifWhileCond.c
build $builddir/pfqn_mvaldmx.o : cc $root/pfqn_mvaldmx.c
build $builddir/find.o : cc $root/find.c
build $builddir/eml_setop.o : cc $root/eml_setop.c
build $builddir/issorted.o : cc $root/issorted.c
build $builddir/pfqn_mvaldmx_ec.o : cc $root/pfqn_mvaldmx_ec.c
build $builddir/pfqn_mvald.o : cc $root/pfqn_mvald.c
build $builddir/_coder_pfqn_mvams_api.o : cc $root/interface/_coder_pfqn_mvams_api.c
build $builddir/_coder_pfqn_mvams_mex.o : cc $root/interface/_coder_pfqn_mvams_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/pprod.o : cc $root/pprod.c
build $builddir/pfqn_mvamx.o : cc $root/pfqn_mvamx.c
build $builddir/div.o : cc $root/div.c
build $builddir/pfqn_mvams_emxutil.o : cc $root/pfqn_mvams_emxutil.c
build $builddir/pfqn_mvams_mexutil.o : cc $root/pfqn_mvams_mexutil.c
build $builddir/_coder_pfqn_mvams_info.o : cc $root/interface/_coder_pfqn_mvams_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/pfqn_mvams_mex.mexa64 : link $builddir/pfqn_mvams_data.o $builddir/rt_nonfinite.o $builddir/pfqn_mvams_initialize.o $builddir/pfqn_mvams_terminate.o $builddir/pfqn_mvams.o $builddir/ixfun.o $builddir/error.o $builddir/sum.o $builddir/repmat.o $builddir/assertCompatibleDims.o $builddir/pfqn_mva.o $builddir/any.o $builddir/prod.o $builddir/sumMatrixIncludeNaN.o $builddir/ifWhileCond.o $builddir/pfqn_mvaldmx.o $builddir/find.o $builddir/eml_setop.o $builddir/issorted.o $builddir/pfqn_mvaldmx_ec.o $builddir/pfqn_mvald.o $builddir/_coder_pfqn_mvams_api.o $builddir/_coder_pfqn_mvams_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/pprod.o $builddir/pfqn_mvamx.o $builddir/div.o $builddir/pfqn_mvams_emxutil.o $builddir/pfqn_mvams_mexutil.o $builddir/_coder_pfqn_mvams_info.o $builddir/c_mexapi_version.o 
