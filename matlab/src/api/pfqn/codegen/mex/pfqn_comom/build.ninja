# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2025a
startdir = /home/gcasale/Dropbox/code/line-dev.git/matlab/src/api/pfqn

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=pfqn_comom_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=pfqn_comom_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o pfqn_comom_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lmwlapack -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_comom.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o pfqn_comom_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lmwlapack -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_comom.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/pfqn_comom_data.o : cc $root/pfqn_comom_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/pfqn_comom_initialize.o : cc $root/pfqn_comom_initialize.c
build $builddir/pfqn_comom_terminate.o : cc $root/pfqn_comom_terminate.c
build $builddir/pfqn_comom.o : cc $root/pfqn_comom.c
build $builddir/repmat.o : cc $root/repmat.c
build $builddir/assertCompatibleDims.o : cc $root/assertCompatibleDims.c
build $builddir/multichoose.o : cc $root/multichoose.c
build $builddir/all.o : cc $root/all.c
build $builddir/bsxfun.o : cc $root/bsxfun.c
build $builddir/find.o : cc $root/find.c
build $builddir/sum.o : cc $root/sum.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/nchoosek.o : cc $root/nchoosek.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/mldivide.o : cc $root/mldivide.c
build $builddir/mtimes.o : cc $root/mtimes.c
build $builddir/_coder_pfqn_comom_api.o : cc $root/interface/_coder_pfqn_comom_api.c
build $builddir/_coder_pfqn_comom_mex.o : cc $root/interface/_coder_pfqn_comom_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/log.o : cc $root/log.c
build $builddir/gammaln.o : cc $root/gammaln.c
build $builddir/applyScalarFunctionInPlace.o : cc $root/applyScalarFunctionInPlace.c
build $builddir/exp.o : cc $root/exp.c
build $builddir/sort.o : cc $root/sort.c
build $builddir/sortIdx.o : cc $root/sortIdx.c
build $builddir/div.o : cc $root/div.c
build $builddir/pfqn_comom_emxutil.o : cc $root/pfqn_comom_emxutil.c
build $builddir/indexShapeCheck.o : cc $root/indexShapeCheck.c
build $builddir/pfqn_comom_mexutil.o : cc $root/pfqn_comom_mexutil.c
build $builddir/_coder_pfqn_comom_info.o : cc $root/interface/_coder_pfqn_comom_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/pfqn_comom_mex.mexa64 : link $builddir/pfqn_comom_data.o $builddir/rt_nonfinite.o $builddir/pfqn_comom_initialize.o $builddir/pfqn_comom_terminate.o $builddir/pfqn_comom.o $builddir/repmat.o $builddir/assertCompatibleDims.o $builddir/multichoose.o $builddir/all.o $builddir/bsxfun.o $builddir/find.o $builddir/sum.o $builddir/sumMatrixIncludeNaN.o $builddir/nchoosek.o $builddir/warning.o $builddir/mldivide.o $builddir/mtimes.o $builddir/_coder_pfqn_comom_api.o $builddir/_coder_pfqn_comom_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/log.o $builddir/gammaln.o $builddir/applyScalarFunctionInPlace.o $builddir/exp.o $builddir/sort.o $builddir/sortIdx.o $builddir/div.o $builddir/pfqn_comom_emxutil.o $builddir/indexShapeCheck.o $builddir/pfqn_comom_mexutil.o $builddir/_coder_pfqn_comom_info.o $builddir/c_mexapi_version.o 
