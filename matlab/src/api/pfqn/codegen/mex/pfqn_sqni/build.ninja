# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2025a
startdir = /home/gcasale/Dropbox/code/line-dev.git/matlab/src/api/pfqn

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=pfqn_sqni_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=pfqn_sqni_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o pfqn_sqni_mex.mexa64 -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_sqni.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o pfqn_sqni_mex.mexa64 -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_sqni.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/pfqn_sqni_data.o : cc $root/pfqn_sqni_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/pfqn_sqni_initialize.o : cc $root/pfqn_sqni_initialize.c
build $builddir/pfqn_sqni_terminate.o : cc $root/pfqn_sqni_terminate.c
build $builddir/pfqn_sqni.o : cc $root/pfqn_sqni.c
build $builddir/combineVectorElements.o : cc $root/combineVectorElements.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/_coder_pfqn_sqni_api.o : cc $root/interface/_coder_pfqn_sqni_api.c
build $builddir/_coder_pfqn_sqni_mex.o : cc $root/interface/_coder_pfqn_sqni_mex.c
build $builddir/div.o : cc $root/div.c
build $builddir/pfqn_sqni_emxutil.o : cc $root/pfqn_sqni_emxutil.c
build $builddir/_coder_pfqn_sqni_info.o : cc $root/interface/_coder_pfqn_sqni_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/pfqn_sqni_mex.mexa64 : link $builddir/pfqn_sqni_data.o $builddir/rt_nonfinite.o $builddir/pfqn_sqni_initialize.o $builddir/pfqn_sqni_terminate.o $builddir/pfqn_sqni.o $builddir/combineVectorElements.o $builddir/sumMatrixIncludeNaN.o $builddir/_coder_pfqn_sqni_api.o $builddir/_coder_pfqn_sqni_mex.o $builddir/div.o $builddir/pfqn_sqni_emxutil.o $builddir/_coder_pfqn_sqni_info.o $builddir/c_mexapi_version.o 
