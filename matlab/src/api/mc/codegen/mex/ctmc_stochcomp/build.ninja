# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2025a
startdir = /home/gcasale/Dropbox/code/line-dev.git/matlab/src/api/mc

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=ctmc_stochcomp_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=ctmc_stochcomp_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o ctmc_stochcomp_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwlapack -lmwblas -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,ctmc_stochcomp.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o ctmc_stochcomp_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwlapack -lmwblas -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,ctmc_stochcomp.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/ctmc_stochcomp_data.o : cc $root/ctmc_stochcomp_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/ctmc_stochcomp_initialize.o : cc $root/ctmc_stochcomp_initialize.c
build $builddir/ctmc_stochcomp_terminate.o : cc $root/ctmc_stochcomp_terminate.c
build $builddir/ctmc_stochcomp.o : cc $root/ctmc_stochcomp.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/qrsolve.o : cc $root/qrsolve.c
build $builddir/_coder_ctmc_stochcomp_api.o : cc $root/interface/_coder_ctmc_stochcomp_api.c
build $builddir/_coder_ctmc_stochcomp_mex.o : cc $root/interface/_coder_ctmc_stochcomp_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/ctmc_stochcomp_emxutil.o : cc $root/ctmc_stochcomp_emxutil.c
build $builddir/_coder_ctmc_stochcomp_info.o : cc $root/interface/_coder_ctmc_stochcomp_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/ctmc_stochcomp_mex.mexa64 : link $builddir/ctmc_stochcomp_data.o $builddir/rt_nonfinite.o $builddir/ctmc_stochcomp_initialize.o $builddir/ctmc_stochcomp_terminate.o $builddir/ctmc_stochcomp.o $builddir/warning.o $builddir/qrsolve.o $builddir/_coder_ctmc_stochcomp_api.o $builddir/_coder_ctmc_stochcomp_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/ctmc_stochcomp_emxutil.o $builddir/_coder_ctmc_stochcomp_info.o $builddir/c_mexapi_version.o 
