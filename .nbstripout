#!/usr/bin/env python3
"""
Git filter to strip Jupyter notebook execution metadata including timestamps.
"""
import json
import sys

def strip_notebook(notebook):
    """Strip execution metadata from notebook."""
    # Remove execution_count from cells
    if 'cells' in notebook:
        for cell in notebook['cells']:
            if 'execution_count' in cell:
                cell['execution_count'] = None
            if 'outputs' in cell:
                for output in cell['outputs']:
                    if 'execution_count' in output:
                        output['execution_count'] = None
    
    # Remove kernel execution metadata
    if 'metadata' in notebook:
        if 'kernelspec' in notebook['metadata']:
            # Keep kernelspec but remove execution-specific data
            kernelspec = notebook['metadata']['kernelspec']
            if 'name' in kernelspec and 'display_name' in kernelspec:
                notebook['metadata']['kernelspec'] = {
                    'name': kernelspec['name'],
                    'display_name': kernelspec['display_name']
                }
        
        # Remove language_info execution metadata but keep basic info
        if 'language_info' in notebook['metadata']:
            lang_info = notebook['metadata']['language_info']
            cleaned_lang_info = {}
            keep_fields = ['name', 'version', 'mimetype', 'file_extension']
            for field in keep_fields:
                if field in lang_info:
                    cleaned_lang_info[field] = lang_info[field]
            if cleaned_lang_info:
                notebook['metadata']['language_info'] = cleaned_lang_info
            else:
                del notebook['metadata']['language_info']
    
    return notebook

if __name__ == '__main__':
    try:
        notebook = json.load(sys.stdin)
        cleaned = strip_notebook(notebook)
        json.dump(cleaned, sys.stdout, indent=1, separators=(',', ': '), ensure_ascii=False)
        sys.stdout.write('\n')
    except (json.JSONDecodeError, KeyError):
        # If not a valid notebook, pass through unchanged
        sys.stdin.seek(0)
        sys.stdout.write(sys.stdin.read())